<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="SmokeTestSuite" verbose="1">
    <listeners>
        <listener class-name="core.TestListener"/>
        <listener class-name="core.RetryListener"/>
    </listeners>
    <parameter name="browser" value="chrome"/>
    <test name="SaucedemoTests">
        <groups>
            <run>
                <include name="authentication"/>
                <include name="products"/>
                <exclude name="login"/>
            </run>
        </groups>
        <classes>
            <class name="saucedemo.ProductsTests"/>
        </classes>
    </test>
</suite>
